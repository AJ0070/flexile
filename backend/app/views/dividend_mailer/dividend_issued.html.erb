<h1 class="text-3xl leading-9 font-bold">Dividend Payment Issued</h1>

<p>Hello <%= @investor.legal_name %>,</p>

<p><strong>You've received a <%= number_to_currency(@dividend.total_amount_in_cents / 100.0) %> dividend payment from your investment in <%= @company.display_name %>.</strong></p>

<dl class="mt-4">
  <dt>Amount</dt>
  <dd><b><%= number_to_currency(@dividend.total_amount_in_cents / 100.0) %></b></dd>
  
  <dt>Payment Date</dt>
  <dd><b><%= @dividend.payment_date&.strftime('%B %d, %Y') || 'Pending' %></b></dd>
  
  <dt>Reference</dt>
  <dd><b>DIV-<%= @dividend.id %></b></dd>
</dl>

<p class="mt-4">This dividend payment will be transferred to your designated payment method. Please allow 3-5 business days for the funds to appear in your account.</p>

<p>If you have any questions about this dividend payment, please don't hesitate to contact our support team.</p>

<p class="mt-4">Best regards,<br>The <%= @company.name %> Team</p>
